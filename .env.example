# Qdrant Cloud connection. Copy to .env and fill in your cluster's values.
# The app, the seed script, and the evals all read these.

# Your cluster endpoint, including the https:// scheme and port if shown in the
# Qdrant Cloud console.
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io

# API key for the cluster (Qdrant Cloud console -> Data Access Control).
QDRANT_API_KEY=your-api-key

# Optional. The collection name. Defaults to "fraud_demo" when unset. The evals
# override this per run so eval traffic never touches the live collection.
# QDRANT_COLLECTION=fraud_demo
